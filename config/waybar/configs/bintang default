/* My Mostly Used waybar config incase you wonder :) */
/* Una barra por monitor: DP-3 muestra 一〜五, HDMI-A-1 muestra 六〜十 */
[
{
"output": "DP-3",
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "bottom",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	//"idle_inhibitor",
	//"custom/separator#blank",
	"clock",
	"custom/weather#ba",
	"custom/separator#blank",
	"tray",
	],

"modules-center": [
	"custom/special-flag#dp3",
	"custom/special#dp3",
	"group/ws-dp3",
	"custom/special-pad#dp3",
	"custom/ws-listener",
	"custom/popups-daemon",
	],

"modules-right": [
        "custom/music#dp3",
        "group/notify",	
	"network",
	"bluetooth",
	"battery",
	"hyprland/language#kb",
	"custom/separator#blank",
	"group/audio",
	"custom/separator#blank",
	"custom/power",
	],
},
{
"output": "HDMI-A-1",
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "bottom",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 3,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"clock",
	"custom/weather#ba",
	"custom/separator#blank",
	"tray",
	],

"modules-center": [
	"custom/special-flag#hdmi",
	"custom/special#hdmi",
	"group/ws-hdmi",
	"custom/special-pad#hdmi",
	],

"modules-right": [
        "custom/music#hdmi",
        "group/notify",	
	"network",
	"bluetooth",
	"battery",
	"hyprland/language#kb",
	"custom/separator#blank",
	"group/audio",
	"custom/separator#blank",
	"custom/power",
	],
}
]
