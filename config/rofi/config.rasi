/*
 * Spotlight-style launcher.
 * Search bar floats top-center; results drop in below it.
 * The app launcher (hyprland.lua `menu`) adds `listview { require-input: true; }`
 * so the list only appears once you start typing. dmenu scripts (clipboard,
 * waybar menus, wallpaper picker) use this same look with the list visible.
 * Colors come from matugen (colors.rasi). Open/close animation is a Hyprland
 * layer rule (configs/windowrules.lua, namespace "rofi").
 * Previous theme: config.rasi.bak-spotlight
 */
@theme "/dev/null"
@import "colors.rasi"

configuration {
    modi:                "drun,run,window";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    drun-display-format: "{name}[<span size='small' alpha='55%'>   {generic}</span>]";
    font:                "JetBrainsMono Nerd Font Propo 11";
    show-icons:          true;
    icon-theme:          "Colloid";
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    scroll-method:       1;
    hover-select:        true;
    me-select-entry:     "MousePrimary";
    me-accept-entry:     "!MousePrimary";
}

* {
    background-color:    transparent;
    text-color:          @on-surface;
}

window {
    transparency:        "real";
    location:            north;
    anchor:              north;
    y-offset:            18%;
    width:               720px;
    border:              1px solid;
    border-color:        @outline-glass;
    border-radius:       26px;
    background-color:    @surface-glass;
    padding:             10px;
    cursor:              "default";
}

mainbox {
    orientation:         vertical;
    spacing:             0px;
    children:            [ "inputbar", "message", "listview" ];
}

/* ---------------------------------------------------------- search bar -- */
inputbar {
    spacing:             14px;
    padding:             12px 16px;
    border-radius:       18px;
    background-color:    @surface-container-glass;
    children:            [ "textbox-search", "entry", "mode-pill" ];
}
textbox-search {
    expand:              false;
    str:                 "";
    font:                "JetBrainsMono Nerd Font Propo 18";
    text-color:          @primary;
    vertical-align:      0.5;
}
entry {
    font:                "JetBrainsMono Nerd Font Propo 17";
    placeholder:         "Search";
    placeholder-color:   @on-surface-variant;
    cursor:              text;
    vertical-align:      0.5;
}
mode-pill {
    expand:              false;
    orientation:         horizontal;
    children:            [ "prompt" ];
    padding:             5px 12px;
    border-radius:       100px;
    background-color:    @primary-glass;
    vertical-align:      0.5;
}
prompt {
    font:                "JetBrainsMono Nerd Font Propo Bold 9";
    text-color:          @primary;
    vertical-align:      0.5;
}

/* ------------------------------------------------------------- results -- */
listview {
    columns:             1;
    lines:               7;
    cycle:               true;
    dynamic:             true;
    fixed-height:        false;
    fixed-columns:       true;
    scrollbar:           false;
    spacing:             4px;
    margin:              10px 0px 0px 0px;
    padding:             10px 0px 0px 0px;
    border:              1px 0px 0px 0px;
    border-color:        @outline-glass;
}

element {
    spacing:             14px;
    padding:             9px 14px;
    border-radius:       14px;
    cursor:              pointer;
}
element normal.normal,
element alternate.normal {
    background-color:    transparent;
    text-color:          @on-surface;
}
element normal.active,
element alternate.active {
    text-color:          @primary;
}
element normal.urgent,
element alternate.urgent {
    background-color:    @error-container;
    text-color:          @on-error-container;
}
element selected.normal,
element selected.active {
    /* gradient background comes from colors.rasi (needs literal colors) */
    text-color:          @on-primary-container;
    border:              0px 0px 0px 3px;
    border-color:        @primary;
}
element selected.urgent {
    background-color:    @error-container;
    text-color:          @on-error-container;
}
element-icon {
    size:                30px;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
}
element-text {
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}

/* ------------------------------------------------------ messages/errors -- */
message {
    margin:              10px 0px 0px 0px;
}
textbox {
    padding:             12px 16px;
    border-radius:       14px;
    background-color:    @surface-container-glass;
    text-color:          @on-surface;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}
error-message {
    padding:             16px;
    border-radius:       20px;
    background-color:    @surface-glass;
    text-color:          @on-surface;
}
