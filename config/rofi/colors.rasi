* {
    primary: #93cdf6;
    primary-fixed: #c8e6ff;
    primary-fixed-dim: #93cdf6;
    on-primary: #00344d;
    on-primary-fixed: #001e2e;
    on-primary-fixed-variant: #004c6d;
    primary-container: #004c6d;
    on-primary-container: #c8e6ff;
    secondary: #b7c9d8;
    secondary-fixed: #d2e5f5;
    secondary-fixed-dim: #b7c9d8;
    on-secondary: #21323e;
    on-secondary-fixed: #0b1d29;
    on-secondary-fixed-variant: #384956;
    secondary-container: #384956;
    on-secondary-container: #d2e5f5;
    tertiary: #cdc0e9;
    tertiary-fixed: #e9ddff;
    tertiary-fixed-dim: #cdc0e9;
    on-tertiary: #342b4b;
    on-tertiary-fixed: #1f1635;
    on-tertiary-fixed-variant: #4b4263;
    tertiary-container: #4b4263;
    on-tertiary-container: #e9ddff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #101417;
    on-surface: #dfe3e7;
    on-surface-variant: #c1c7ce;
    outline: #8b9198;
    outline-variant: #41484d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe3e7;
    inverse-on-surface: #2d3135;
    inverse-primary: #236488;
    surface-dim: #101417;
    surface-bright: #353a3d;
    surface-container-lowest: #0a0f12;
    surface-container-low: #181c20;
    surface-container: #1c2024;
    surface-container-high: #262a2e;
    surface-container-highest: #313539;
    /* translucent variants (spotlight launcher) */
    surface-glass: #101417D9;
    surface-container-glass: #262a2eB3;
    primary-glass: #93cdf633;
    outline-glass: #8b919855;
}

/* selected row gradient: rofi can't use @refs inside linear-gradient */
element selected.normal, element selected.active {
    background-image: linear-gradient(to right, #004c6d, #384956E6);
}
