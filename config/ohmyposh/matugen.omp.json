{
  "Created": "Phunt_Vieg_",
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "_comment": "Diseño base. La paleta la reemplaza matugen -> matugen.omp.json (ver ~/.config/matugen/scripts/ohmyposh-build.py). Esta paleta es solo fallback.",
  "palette": {
    "primary": "#ffb4a3",
    "on_primary": "#561f12",
    "primary_container": "#733426",
    "on_primary_container": "#ffdad2",
    "secondary": "#e7bdb4",
    "secondary_container": "#5d3f39",
    "on_secondary_container": "#ffdad2",
    "tertiary": "#dbc58c",
    "tertiary_container": "#544519",
    "on_tertiary_container": "#f8e0a6",
    "error": "#ffb4ab",
    "surface_high": "#322825",
    "on_surface": "#f1dfdb",
    "on_surface_variant": "#d8c2bd",
    "outline": "#a08c88"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:outline",
          "template": "╭─"
        },
        {
          "type": "session",
          "style": "diamond",
          "background": "p:primary",
          "foreground": "p:on_primary",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "{{ if ne (.Segments.Contains \"Python\") true }}  {{ .UserName }} {{ end }}"
        },
        {
          "type": "python",
          "style": "diamond",
          "background": "p:primary",
          "foreground": "p:on_primary",
          "leading_diamond": "",
          "trailing_diamond": "",
          "properties": {
            "display_mode": "environment",
            "home_enabled": true,
            "folder_name_fallback": false
          },
          "template": "  {{ .Venv }} "
        },
        {
          "type": "path",
          "style": "diamond",
          "background": "p:secondary_container",
          "foreground": "p:on_secondary_container",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "properties": {
            "style": "full"
          },
          "template": "   {{ .Path }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "background": "p:tertiary_container",
          "foreground": "p:on_tertiary_container",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "properties": {
            "branch_icon": "",
            "fetch_stash_count": true,
            "fetch_status": false,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}  {{ .HEAD }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "background": "p:surface_high",
          "foreground": "p:tertiary",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "properties": {
            "time_format": "15:04"
          },
          "template": "{{ if ne (.Segments.Contains \"Git\") true }} {{ .CurrentDate | date .Format }} {{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:outline",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:primary",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:error{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "template": "⚡"
        }
      ]
    }
  ],
  "transient_prompt": {
    "template": "<p:primary> </><p:secondary></><p:tertiary></> "
  },
  "final_space": true,
  "version": 8
}