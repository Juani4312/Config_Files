{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 5,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 24,
  "notification-body-image-height": 100,
  "notification-body-image-width": 100,
  "notification-window-width": 390,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 520,
  "control-center-height": 790,
  "keyboard-shortcuts": true,
  "image-visibility": "when available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "notification-visibility": {
    "tema-resumen": {
      "category": "^theme\\.summary$",
      "state": "transient"
    },
    "tema-apps": {
      "category": "^theme\\.app$",
      "state": "muted"
    }
  },
  "widgets": [
    "menubar#top",
    "menubar#resize",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟"
    },
    "backlight": {
      "label": "󰃟"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification"
    },
    "menubar#resize": {
      "buttons#arrows": {
        "position": "right",
        "actions": [
          {
            "label": "◂",
            "command": "bash -c '$HOME/.config/swaync/scripts/resize.sh w+'"
          },
          {
            "label": "▸",
            "command": "bash -c '$HOME/.config/swaync/scripts/resize.sh w-'"
          },
          {
            "label": "▴",
            "command": "bash -c '$HOME/.config/swaync/scripts/resize.sh h-'"
          },
          {
            "label": "▾",
            "command": "bash -c '$HOME/.config/swaync/scripts/resize.sh h+'"
          }
        ]
      }
    },
    "menubar#top": {
      "buttons#title": {
        "position": "left",
        "actions": [
          {
            "label": "Notifications",
            "command": ""
          }
        ]
      },
      "buttons#actions": {
        "position": "right",
        "actions": [
          {
            "label": "󰽥",
            "type": "toggle",
            "active": false,
            "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && swaync-client -dn || swaync-client -df'",
            "update-command": "sh -c 'swaync-client -D'"
          },
          {
            "label": "󰎟",
            "command": "sh -c 'swaync-client -C; swaync-client -cp'"
          }
        ]
      }
    }
  }
}
