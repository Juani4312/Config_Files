    "notificationCenterHeader.background": "{{colors.surface_container_high.default.hex}}",
    "notificationsErrorIcon.foreground": "{{colors.error.default.hex}}",
    "notificationsWarningIcon.foreground": "{{colors.tertiary.default.hex}}",
    "notificationsInfoIcon.foreground": "{{colors.secondary.default.hex}}",

    "panel.background": "{{colors.surface_container_low.default.hex}}",
    "panel.border": "{{colors.outline_variant.default.hex}}",
    "panelTitle.activeForeground": "{{colors.primary.default.hex}}",
    "panelTitle.activeBorder": "{{colors.primary.default.hex}}",
    "panelTitle.inactiveForeground": "{{colors.outline.default.hex}}",
    "statusBar.background": "{{colors.surface_container_lowest.default.hex}}",
    "statusBar.foreground": "{{colors.on_surface_variant.default.hex}}",
    "statusBar.border": "{{colors.surface_container_lowest.default.hex}}",
    "statusBar.noFolderBackground": "{{colors.surface_container_lowest.default.hex}}",
    "statusBar.debuggingBackground": "{{colors.tertiary_container.default.hex}}",
    "statusBar.debuggingForeground": "{{colors.on_tertiary_container.default.hex}}",
