    "terminal.ansiBrightRed": "{{colors.error.default.hex}}",
    "terminal.ansiBrightGreen": "{{colors.primary.default.hex}}",
    "terminal.ansiBrightYellow": "{{colors.tertiary.default.hex}}",
    "terminal.ansiBrightBlue": "{{colors.on_primary_container.default.hex}}",
    "terminal.ansiBrightMagenta": "{{colors.on_secondary_container.default.hex}}",
    "terminal.ansiBrightCyan": "{{colors.secondary.default.hex}}",
    "terminal.ansiBrightWhite": "{{colors.on_surface.default.hex}}",

    "gitDecoration.addedResourceForeground": "{{colors.tertiary.default.hex}}",
    "gitDecoration.untrackedResourceForeground": "{{colors.tertiary.default.hex}}",
    "gitDecoration.modifiedResourceForeground": "{{colors.secondary.default.hex}}",
    "gitDecoration.deletedResourceForeground": "{{colors.error.default.hex}}",
    "gitDecoration.ignoredResourceForeground": "{{colors.outline_variant.default.hex}}",
    "gitDecoration.conflictingResourceForeground": "{{colors.primary.default.hex}}",
    "welcomePage.tileBackground": "{{colors.surface_container.default.hex}}",
    "walkThrough.embeddedEditorBackground": "{{colors.surface_container_low.default.hex}}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "{{colors.tertiary_fixed.default.hex}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "{{colors.error.default.hex}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "{{colors.primary_fixed.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class"],
      "settings": { "foreground": "{{colors.tertiary_fixed.default.hex}}" } },
    { "scope": ["variable", "meta.definition.variable"],
      "settings": { "foreground": "{{colors.on_surface.default.hex}}" } },
    { "scope": ["variable.parameter"],
      "settings": { "foreground": "{{colors.secondary.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.other.object.property", "variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "{{colors.tertiary_fixed.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "meta.import"],
      "settings": { "foreground": "{{colors.on_primary_container.default.hex}}" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "entity.name.function.preprocessor"],
      "settings": { "foreground": "{{colors.secondary.default.hex}}" } },
    { "scope": ["invalid"],
      "settings": { "foreground": "{{colors.on_error.default.hex}}", "background": "{{colors.error.default.hex}}" } },
    { "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "{{colors.primary_fixed.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "{{colors.secondary.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{colors.tertiary.default.hex}}", "fontStyle": "underline" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "{{colors.tertiary.default.hex}}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "{{colors.error.default.hex}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{colors.secondary.default.hex}}" } }
  ]
}
