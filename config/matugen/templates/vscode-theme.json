    "keybindingLabel.foreground": "{{colors.on_surface.default.hex}}",
    "keybindingLabel.border": "{{colors.outline_variant.default.hex}}",
    "keybindingLabel.bottomBorder": "{{colors.outline_variant.default.hex}}",
    "notifications.background": "{{colors.surface_container.default.hex}}",
    "notifications.foreground": "{{colors.on_surface.default.hex}}",
