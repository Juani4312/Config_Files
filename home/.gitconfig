[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
# Identidad (user.name / user.email) fuera del repo público: install.sh crea este archivo si falta
[include]
	path = ~/.gitconfig.local
[includeIf "gitdir:~/Documents/ITBA/"]
	path = ~/.gitconfig-itba
