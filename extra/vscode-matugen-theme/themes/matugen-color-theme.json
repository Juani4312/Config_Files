  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8b9198", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#95cdf7" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace"],
      "settings": { "foreground": "#c1c7ce" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"],
      "settings": { "foreground": "#cfc0e8" } },
    { "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#eaddff" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "#ffb4ab" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#c9e6ff", "fontStyle": "bold" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class"],
      "settings": { "foreground": "#eaddff" } },
    { "scope": ["variable", "meta.definition.variable"],
      "settings": { "foreground": "#e0e3e8" } },
    { "scope": ["variable.parameter"],
      "settings": { "foreground": "#b7c9d9", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.other.object.property", "variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#b7c9d9" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": { "foreground": "#95cdf7" } },
    { "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#eaddff", "fontStyle": "italic" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "meta.import"],
      "settings": { "foreground": "#c9e6ff" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#b7c9d9" } },
    { "scope": ["invalid"],
      "settings": { "foreground": "#690005", "background": "#ffb4ab" } },
    { "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#95cdf7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#c9e6ff", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#b7c9d9", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#cfc0e8", "fontStyle": "underline" } },
    { "scope": ["markup.list", "punctuation.definition.list"], "settings": { "foreground": "#95cdf7" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#c1c7ce", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#cfc0e8" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ffb4ab" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#b7c9d9" } }
  ]
}
